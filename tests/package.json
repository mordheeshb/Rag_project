{
  "name": "itb-tests",
  "version": "1.0.0",
  "description": "Tests for Instant Technician Booker",
  "scripts": {
    "test": "jest --runInBand --detectOpenHandles",
    "test:unit": "jest tests/unit --runInBand",
    "test:integration": "jest tests/integration --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "testMatch": ["**/tests/**/*.test.js"]
  },
  "dependencies": {
    "axios": "^1.7.2",
    "mongoose": "^8.4.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
